{
  "name": "campus-canteen-express",
  "version": "1.0.0",
  "description": "Campus food pre-ordering and express pickup web application",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "db:migrate": "node database/migrate-sqlite-to-mysql.js",
    "seed": "node database/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit --testPathIgnorePatterns=\"adversarial_db|empirical_challenge\"",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:e2e": "cross-env NODE_ENV=test jest tests/e2e --runInBand --forceExit"
  },
  "keywords": [
    "canteen",
    "food-preorder",
    "express-pickup",
    "sqlite",
    "express",
    "vanilla-js"
  ],
  "author": "Campus Canteen Express Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
