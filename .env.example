# Application Server Configuration
PORT=5000
NODE_ENV=development
DEBUG_SQL=false

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=campuscanteen
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=campus_canteen
DATABASE_URL=mysql://campuscanteen:YOUR_MYSQL_PASSWORD_HERE@localhost:3306/campus_canteen

# JWT Authentication Secret (Minimum 32 random characters for production)
JWT_SECRET=super_secret_jwt_key_campus_canteen_2026_express_secure_token

# Razorpay Credentials (Optional - Leave blank to use automated Mock Payment Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Express Pickup Fee (Authoritative backend charge in INR)
EXPRESS_PICKUP_FEE=3.00
EXPRESS_FEE_TODAY=3.00
EXPRESS_FEE_TOMORROW=1.00
